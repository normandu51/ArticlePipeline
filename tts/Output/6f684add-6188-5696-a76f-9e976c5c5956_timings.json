      "end_time": 6.9,
      "duration": 3.975,
      "phoneme_count": 54
    },
    {
      "id": 2,
      "sentence": "The pan on each side held a card.",
      "paragraph_id": 0,
      "word_count": 8,
      "start_time": 6.9,
      "end_time": 9.725,
      "duration": 2.825,
      "phoneme_count": 35
    },
    {
      "id": 3,
      "sentence": "One read: \u201cThe opinions of forensic scientists.\u201d The other: \u201cThe opinions of lawyers.\u201d",
      "paragraph_id": 1,
      "word_count": 13,
      "start_time": 9.725,
      "end_time": 16.175,
