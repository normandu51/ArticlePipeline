    "headline": "My City Is the Heart of Europe, and It\u2019s Not Doing Well",
    "source_db": "/Users/pengdu/PycharmProjects/ArticleExtraction/articles.db",
    "audio_file": "/Users/pengdu/PycharmProjects/ArticleExtraction/tts/Output/e5c5a77f-8261-5a71-8660-07172423282e_kokoro.wav",
